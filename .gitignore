# Asset meta files must be tracked
!/[Aa]ssets/**/*.meta

# Ignore specific Unity generated files
.collabignore
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.IDB
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D Generated File On Crash Reports
sysinfo.txt

# Builds
*.apk
*.unitypackage
.DS_Store
ProjectSettings/SceneTemplateSettings.json
